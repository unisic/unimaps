# Konfiguracja Unimaps.
# Wszystkie zmienne sa opcjonalne — ponizej podane wartosci domyslne.
# Skopiuj ten plik do .env i odkomentuj tylko to, co chcesz zmienic.

# Adres bazowy upstream API (KiedyPrzyjedzie)
#KB_BASE_URL=https://komunikacjabeskidzka.kiedyprzyjedzie.pl

# User-Agent wysylany do upstreamow KB, MZK i GZM (oraz do OSRM, jesli brak KB_OSRM_USER_AGENT)
#KB_USER_AGENT=unimaps/2.0 (+https://github.com/unisic/unimaps)

# Liczba rownoleglych polaczen HTTP scrapera
#KB_CONCURRENCY=40

# Timeout pojedynczego zapytania HTTP (sekundy)
#KB_HTTP_TIMEOUT=20

# Pelny skan wszystkich przystankow (sekundy)
#KB_SCAN_INTERVAL=90

# Smart scan — skan przyrostowy miedzy pelnymi skanami (sekundy)
#KB_SMART_SCAN_INTERVAL=30

# Odswiezanie pozycji aktywnych pojazdow (sekundy)
#KB_REFRESH_INTERVAL=10

# Horyzont odjazdow brany pod uwage przy skanie (sekundy)
#KB_CANDIDATE_HORIZON=7200

# Jak dlugo cache'owac odpowiedzi 404 dla trip_execution (sekundy)
#KB_404_CACHE=30

# Rozmiar paczki zapytan przy skanie.
# UWAGA: upstream ucina odpowiedz /api/departures do 6 tablic na zapytanie
# (nadmiarowe przystanki po prostu znikaja z odpowiedzi) — nie zwiekszac.
#KB_BATCH_SIZE=6

# Globalny limit zapytan do tras passthrough, dla wszystkich klientow lacznie
# (utrzymywane zapytania/s; limit chwilowy to 8x ta wartosc)
#KB_RATE_LIMIT_GLOBAL=500

# Wiek feedu (sekundy od ostatniego potwierdzonego kontaktu z upstreamem),
# po ktorym /api/health zglasza "degraded" (HTTP 503)
#KB_HEALTH_STALE_SEC=1200

# Jak czesto poller przeladowuje liste przystankow (sekundy)
#KB_STOPS_RELOAD_SEC=86400

# Korekta opoznienia KB z GPS: gdy indeks przystanku z upstreamu "stoi" za autobusem
# (autobus mija przystanki bez zatrzymania), opoznienie liczone jest z rozkladu dla
# pozycji GPS zamiast z estymaty upstreamu (0 wylacza)
#KB_GPS_DELAY=1

# Automatyczna nocna przebudowa feedu GTFS i rozkladu MZK w procesie serwera (0 wylacza)
#KB_GTFS_AUTOBUILD=1

# Godzina (Europe/Warsaw), po ktorej feed z wczorajsza data jest przebudowywany
#KB_GTFS_BUILD_HOUR=3
# Days of output/fleet-history-<day>.json kept; older files are deleted at midnight.
#KB_FLEET_HISTORY_DAYS=365

# Rownoleglosc HTTP nocnej przebudowy GTFS
#KB_GTFS_BUILD_CONCURRENCY=10

# Trasy po drogach liczone na serwerze (magazyn tras, lib/shape-store.ts).
# Serwer routingu OSRM; "off" wylacza routing (autobusy KB jada wtedy prosto
# do nastepnego przystanku, trasy MZK dzialaja dalej).
#KB_OSRM_URL=https://router.project-osrm.org/route/v1/driving
# Minimalny odstep miedzy zapytaniami do OSRM (ms; na publicznym serwerze >=1000)
#KB_OSRM_MIN_INTERVAL_MS=1100
# User-Agent wysylany do OSRM (wymagany przez regulamin publicznego serwera; domyslnie KB_USER_AGENT)
#KB_OSRM_USER_AGENT=unimaps/2.0 (+https://github.com/unisic/unimaps)
# Wyszukiwarka adresow (API Photon, dane OpenStreetMap) dla polaczen z adresu;
# "off" wylacza wyszukiwanie adresow (zostaja przystanki i "Moja lokalizacja").
#KB_GEOCODER_URL=https://photon.komoot.io/api/
# Po ilu dniach trasa jest stopniowo wyznaczana ponownie
#KB_SHAPES_MAX_AGE_DAYS=14
# Plik magazynu tras (poza output/gtfs, ktory builder podmienia w calosci)
#KB_SHAPES_FILE=output/shapes/route-shapes.v1.json

# Kierunki jazdy przystankow MZK uczone z biegnacych kursow (lib/mzk-stop-dirs.ts);
# pomagaja sparowac przystanek KB z biegunem MZK po wlasciwej stronie ulicy
# (poza output/gtfs, ktory builder podmienia w calosci)
#KB_MZK_STOP_DIRS_FILE=output/mzk-stop-dirs.v1.json

# Rozklad MZK dla wyszukiwarki polaczen, budowany z OnTime raz na dobe (lib/mzk-timetable.ts)
#KB_MZK_TIMETABLE_FILE=output/mzk-timetable.v1.json

# Metropolia GZM: drugie miasto w tym samym procesie (lib/gzm.ts); 0 wylacza
# (kazde zapytanie ?city=gzm albo z id gzm: odpowiada wtedy 404)
#KB_GZM=1
# Rozklad GZM (GTFS: przystanki, kursy, trasy, brygady) i pozycje na zywo z zbiorkom api6-open
#KB_GZM_GTFS_URL=https://api.zbiorkom.live/api6-open/gzm/gtfs/default
#KB_GZM_POSITIONS_URL=https://api.zbiorkom.live/api6-open/gzm/positions/18.3,49.9,19.7,50.7
# Nakladka pozycji z SDIP co 5 s, tylko gdy ktos oglada GZM (0 wylacza)
#KB_GZM_SDIP=1
#KB_GZM_SDIP_URL=https://sdip.transportgzm.pl/vm/main
# Ostatni dobry zip GTFS i historia floty GZM
#KB_GZM_DIR=output/gzm
# Ile dni historii floty GZM trzymac na dysku (~12-14 MB na dzien, 30 dni = ~400 MB)
#KB_GZM_FLEET_HISTORY_DAYS=30

# Powiadomienia web push o odjezdzie ("Powiadom mnie" przy zamknietej aplikacji); 0 = wylaczone,
# alerty dzialaja wtedy tylko przy otwartej aplikacji
#KB_PUSH=1
# Para kluczy VAPID i oczekujace alerty (klucze tworzone raz: nowa para uniewaznia subskrypcje)
#KB_PUSH_DIR=output/push
# Kontakt widoczny dla uslug push (mailto: albo https:)
#KB_PUSH_SUBJECT=https://github.com/unisic/unimaps

# Port serwera HTTP
#PORT=8080
