# Konfiguracja KB-GTFS.
# Wszystkie zmienne sa opcjonalne — ponizej podane wartosci domyslne.
# Skopiuj ten plik do .env i odkomentuj tylko to, co chcesz zmienic.

# Adres bazowy upstream API (KiedyPrzyjedzie)
#KB_BASE_URL=https://komunikacjabeskidzka.kiedyprzyjedzie.pl

# Liczba rownoleglych polaczen HTTP scrapera
#KB_CONCURRENCY=40

# Timeout pojedynczego zapytania HTTP (sekundy)
#KB_HTTP_TIMEOUT=20

# Pelny skan wszystkich przystankow (sekundy)
#KB_SCAN_INTERVAL=90

# Smart scan — skan przyrostowy miedzy pelnymi skanami (sekundy)
#KB_SMART_SCAN_INTERVAL=30

# Odswiezanie pozycji aktywnych pojazdow (sekundy)
#KB_REFRESH_INTERVAL=10

# Horyzont odjazdow brany pod uwage przy skanie (sekundy)
#KB_CANDIDATE_HORIZON=7200

# Jak dlugo cache'owac odpowiedzi 404 dla trip_execution (sekundy)
#KB_404_CACHE=30

# Rozmiar paczki zapytan przy skanie.
# UWAGA: upstream ucina odpowiedz /api/departures do 6 tablic na zapytanie
# (nadmiarowe przystanki po prostu znikaja z odpowiedzi) — nie zwiekszac.
#KB_BATCH_SIZE=6

# Globalny limit zapytan do tras passthrough, dla wszystkich klientow lacznie
# (utrzymywane zapytania/s; limit chwilowy to 8x ta wartosc)
#KB_RATE_LIMIT_GLOBAL=500

# Wiek feedu (sekundy od ostatniego potwierdzonego kontaktu z upstreamem),
# po ktorym /api/health zglasza "degraded" (HTTP 503)
#KB_HEALTH_STALE_SEC=1200

# Jak czesto poller przeladowuje liste przystankow (sekundy)
#KB_STOPS_RELOAD_SEC=86400

# Automatyczna nocna przebudowa feedu GTFS w procesie serwera (0 wylacza)
#KB_GTFS_AUTOBUILD=1

# Godzina (Europe/Warsaw), po ktorej feed z wczorajsza data jest przebudowywany
#KB_GTFS_BUILD_HOUR=3

# Rownoleglosc HTTP nocnej przebudowy GTFS
#KB_GTFS_BUILD_CONCURRENCY=10

# Trasy po drogach liczone na serwerze (magazyn tras, lib/shape-store.ts).
# Serwer routingu OSRM; "off" wylacza routing (autobusy KB jada wtedy prosto
# do nastepnego przystanku, trasy MZK dzialaja dalej).
#KB_OSRM_URL=https://router.project-osrm.org/route/v1/driving
# Minimalny odstep miedzy zapytaniami do OSRM (ms; na publicznym serwerze >=1000)
#KB_OSRM_MIN_INTERVAL_MS=1100
# User-Agent wysylany do OSRM (wymagany przez regulamin publicznego serwera)
#KB_OSRM_USER_AGENT=kb-map/2.0 (+https://github.com/DeBondor/kb-map)
# Po ilu dniach trasa jest stopniowo wyznaczana ponownie
#KB_SHAPES_MAX_AGE_DAYS=14
# Plik magazynu tras (poza output/gtfs, ktory builder podmienia w calosci)
#KB_SHAPES_FILE=output/shapes/route-shapes.v1.json

# Port serwera HTTP
#PORT=8080
