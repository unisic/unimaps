# Konfiguracja Unimaps.
# Wszystkie zmienne sa opcjonalne, ponizej podane wartosci domyslne.
# Serwer czyta kazda raz, przy pierwszym uzyciu: zmiana wymaga restartu.
# Skopiuj ten plik do .env i odkomentuj tylko to, co chcesz zmienic.

# Adres bazowy upstream API (KiedyPrzyjedzie)
#KB_BASE_URL=https://komunikacjabeskidzka.kiedyprzyjedzie.pl

# User-Agent wysylany do upstreamow KB, MZK i GZM (oraz do OSRM, jesli brak KB_OSRM_USER_AGENT)
#KB_USER_AGENT=unimaps/2.0 (+https://github.com/unisic/unimaps)

# Liczba rownoleglych polaczen HTTP scrapera
#KB_CONCURRENCY=40

# Timeout pojedynczego zapytania HTTP (sekundy)
#KB_HTTP_TIMEOUT=20

# Pelny skan wszystkich przystankow (sekundy)
#KB_SCAN_INTERVAL=90

# Smart scan: skan przyrostowy miedzy pelnymi skanami (sekundy)
#KB_SMART_SCAN_INTERVAL=30

# Odswiezanie pozycji aktywnych pojazdow (sekundy)
#KB_REFRESH_INTERVAL=10

# Horyzont odjazdow brany pod uwage przy skanie (sekundy)
#KB_CANDIDATE_HORIZON=7200

# Jak dlugo cache'owac odpowiedzi 404 dla trip_execution (sekundy)
#KB_404_CACHE=30

# Smart scan obejmuje przystanki z odjazdem w ciagu tylu sekund
#KB_SMART_SCAN_WINDOW=600
# Przystanek bez odjazdow nie jest ponownie skanowany przez tyle sekund
#KB_STOP_EMPTY_CACHE=120
# Przystanek, ktorego najblizszy odjazd jest dalej niz KB_STOP_FAR_THRESHOLD s,
# czeka KB_STOP_FAR_CACHE s na ponowny skan
#KB_STOP_FAR_THRESHOLD=1800
#KB_STOP_FAR_CACHE=180

# Filtr pojazdow-duchow: pojazd bez odswiezenia (albo stojacy bez estymaty opoznienia)
# przez tyle sekund znika z mapy; ruch ponizej KB_STALE_MOVE_EPS_M metrow nie liczy sie jako ruch
#KB_STALE_VEHICLE_SEC=300
#KB_STALE_MOVE_EPS_M=15

# Rewizja listy przystankow KB, gdy nie da sie jej odczytac ze strony upstreamu
# (data-stops-revision) i nie ma jeszcze ostatniej dobrej
#KB_STOPS_REVISION=6829

# Rozmiar paczki zapytan przy skanie.
# UWAGA: upstream ucina odpowiedz /api/departures do 6 tablic na zapytanie
# (nadmiarowe przystanki po prostu znikaja z odpowiedzi), nie zwiekszac.
#KB_BATCH_SIZE=6

# Globalny limit zapytan do tras passthrough, dla wszystkich klientow lacznie
# (utrzymywane zapytania/s; limit chwilowy to 8x ta wartosc)
#KB_RATE_LIMIT_GLOBAL=500

# Wiek feedu (sekundy od ostatniego potwierdzonego kontaktu z upstreamem),
# po ktorym /api/health zglasza "degraded" (HTTP 503)
#KB_HEALTH_STALE_SEC=1200

# Jak czesto poller przeladowuje liste przystankow (sekundy)
#KB_STOPS_RELOAD_SEC=86400

# Korekta opoznienia KB z GPS: gdy indeks przystanku z upstreamu "stoi" za autobusem
# (autobus mija przystanki bez zatrzymania), opoznienie liczone jest z rozkladu dla
# pozycji GPS zamiast z estymaty upstreamu (0 wylacza)
#KB_GPS_DELAY=1

# Automatyczna nocna przebudowa feedu GTFS i rozkladu MZK w procesie serwera (0 wylacza)
#KB_GTFS_AUTOBUILD=1

# Godzina (Europe/Warsaw), po ktorej feed z wczorajsza data jest przebudowywany
#KB_GTFS_BUILD_HOUR=3
# Ile dni plikow output/fleet-history-<dzien>.json trzymac; starsze kasowane o polnocy
#KB_FLEET_HISTORY_DAYS=365

# Rownoleglosc HTTP nocnej przebudowy GTFS
#KB_GTFS_BUILD_CONCURRENCY=10

# Strefa czasowa przewoznika: cala matematyka rozkladowa liczy sekundy od polnocy w tej strefie
#KB_AGENCY_TIMEZONE=Europe/Warsaw
# agency.txt budowanego feedu GTFS
#KB_AGENCY_ID=KB
#KB_AGENCY_NAME=Komunikacja Beskidzka S.A.
#KB_AGENCY_URL=https://komunikacjabeskidzka.kiedyprzyjedzie.pl
#KB_AGENCY_LANG=pl

# Katalog danych generowanych (domyslnie <katalog roboczy>/output); od niego zaleza
# domyslne sciezki ponizej (output/gtfs, output/shapes, output/gzm, output/push, ...)
#KB_OUTPUT_DIR=output
# Feed GTFS Bielska-Bialej (builder podmienia ten katalog w calosci)
#KB_GTFS_DIR=output/gtfs

# Trasy po drogach liczone na serwerze (magazyn tras, backend/src/shape_store.rs).
# Serwer routingu OSRM; "off" wylacza routing (autobusy KB jada wtedy prosto
# do nastepnego przystanku, trasy MZK dzialaja dalej).
#KB_OSRM_URL=https://router.project-osrm.org/route/v1/driving
# Minimalny odstep miedzy zapytaniami do OSRM (ms; na publicznym serwerze >=1000)
#KB_OSRM_MIN_INTERVAL_MS=1100
# User-Agent wysylany do OSRM (wymagany przez regulamin publicznego serwera; domyslnie KB_USER_AGENT)
#KB_OSRM_USER_AGENT=unimaps/2.0 (+https://github.com/unisic/unimaps)
# Wyszukiwarka adresow (API Photon, dane OpenStreetMap) dla polaczen z adresu;
# "off" wylacza wyszukiwanie adresow (zostaja przystanki i "Moja lokalizacja").
#KB_GEOCODER_URL=https://photon.komoot.io/api/
# Klucz TomTom (my.tomtom.com, darmowy plan: 20 000 zapytan Flow Segment Data/miesiac) dla /api/traffic:
# predkosc ruchu pod sledzonym autobusem spowalnia jego plynny ruch w korku. Pusty = wylaczone (404).
# Serwer pyta TomTom najwyzej 600 razy na dobe (UTC).
#KB_TOMTOM_KEY=
# Wyciag OpenStreetMap (.osm.pbf), z ktorego serwer liczy minuty pieszo po chodnikach (przesiadki, dojscia);
# pobierany do output/foot/ (~190 MB), odswiezany przy starcie po 30 dniach, w pamieci ~75 MB.
# "off" = minuty pieszo w linii prostej.
#KB_FOOT_PBF_URL=https://download.geofabrik.de/europe/poland/slaskie-latest.osm.pbf
# Po ilu dniach trasa jest stopniowo wyznaczana ponownie
#KB_SHAPES_MAX_AGE_DAYS=14
# Plik magazynu tras (poza output/gtfs, ktory builder podmienia w calosci)
#KB_SHAPES_FILE=output/shapes/route-shapes.v1.json

# Kierunki jazdy przystankow MZK uczone z biegnacych kursow (backend/src/mzk_stop_dirs.rs);
# pomagaja sparowac przystanek KB z biegunem MZK po wlasciwej stronie ulicy
# (poza output/gtfs, ktory builder podmienia w calosci)
#KB_MZK_STOP_DIRS_FILE=output/mzk-stop-dirs.v1.json

# Rozklad MZK dla wyszukiwarki polaczen, budowany z OnTime raz na dobe (backend/src/mzk_timetable.rs)
#KB_MZK_TIMETABLE_FILE=output/mzk-timetable.v1.json

# Metropolia GZM: drugie miasto w tym samym procesie (backend/src/gzm/); 0 wylacza
# (kazde zapytanie ?city=gzm albo z id gzm: odpowiada wtedy 404)
#KB_GZM=1
# Rozklad GZM (GTFS: przystanki, kursy, trasy, brygady) i pozycje na zywo z zbiorkom api6-open
#KB_GZM_GTFS_URL=https://api.zbiorkom.live/api6-open/gzm/gtfs/default
#KB_GZM_POSITIONS_URL=https://api.zbiorkom.live/api6-open/gzm/positions/18.3,49.9,19.7,50.7
# Nakladka pozycji z SDIP co 5 s, tylko gdy ktos oglada GZM (0 wylacza)
#KB_GZM_SDIP=1
#KB_GZM_SDIP_URL=https://sdip.transportgzm.pl/vm/main
# Strona aktualnosci ZTM scrapowana jako "Utrudnienia" GZM (co 15 min); off = brak komunikatow GZM (404)
#KB_GZM_NEWS_URL=https://rj.transportgzm.pl/v2/news/
# Ostatni dobry zip GTFS i historia floty GZM
#KB_GZM_DIR=output/gzm
# Ile dni historii floty GZM trzymac na dysku (~12-14 MB na dzien, 30 dni = ~400 MB)
#KB_GZM_FLEET_HISTORY_DAYS=30

# Pozostale miasta zbiorkom (lib/shared/cities.json: Warszawa, Krakow, Lodz, Wroclaw, Poznan, ...); 0 wylacza
# (?city=<slug> i id <slug>: odpowiadaja wtedy 404). Rozklad i pozycje kazdego miasta z api6-open,
# wczytywane dopiero przy pierwszym zapytaniu, pozycje odpytywane tylko gdy ktos oglada (120 s)
#KB_ZB=1
#KB_ZB_API_URL=https://api.zbiorkom.live/api6-open
# Ile takich miast trzymac naraz w pamieci (rozklad = 25-60 MB pamieci na miasto; LRU powyzej)
#KB_ZB_RESIDENT=2
# Po ilu minutach bez zapytan zwolnic rozklad miasta z pamieci
#KB_ZB_IDLE_MIN=30

# Powiadomienia web push: o odjezdzie ("Powiadom mnie" przy zamknietej aplikacji) i o nowych
# utrudnieniach ("Powiadamiaj o utrudnieniach"); 0 = wylaczone, alerty dzialaja wtedy tylko przy otwartej aplikacji
#KB_PUSH=1
# Para kluczy VAPID, oczekujace alerty i subskrypcje utrudnien (klucze tworzone raz: nowa para uniewaznia subskrypcje)
#KB_PUSH_DIR=output/push
# Kontakt widoczny dla uslug push (mailto: albo https:)
#KB_PUSH_SUBJECT=https://github.com/unisic/unimaps

# Port serwera HTTP (w `npm run dev` port Vite)
#PORT=8080
# Adres nasluchu (nie HOSTNAME: powloka i Docker ustawiaja tam nazwe maszyny)
#HOST=0.0.0.0
# Katalog statycznego frontendu (wynik `npm run build`, domyslnie <katalog roboczy>/out);
# brak katalogu = strony odpowiadaja 404, API dziala dalej
#KB_STATIC_DIR=out
# Tylko `npm run dev`: port API (serwer w Ruscie na 127.0.0.1), na ktory Vite przekazuje /api
#KB_API_PORT=8081

# Poziom logow: info, warn albo error
#KB_LOG_LEVEL=info
