{
  "name": "unimaps",
  "version": "2.0.0",
  "private": true,
  "description": "Live public transport map for Bielsko-Biała and Metropolia GZM: GTFS + GTFS-Realtime scraper, server & map",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "protobufjs-cli": {
      "glob": "^13.0.0"
    },
    "markdown-it": "^14.3.3"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/dev.ts",
    "build": "vite build && node scripts/compress-static.mjs out && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:fleet": "tsx scripts/test-live-fleet.ts",
    "build:gtfs": "tsx scripts/build-gtfs.ts",
    "benchmark": "tsx scripts/benchmark-search.ts",
    "benchmark:site": "tsx scripts/benchmark-site.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0",
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.5"
  }
}
