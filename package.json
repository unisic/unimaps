{
  "name": "unimaps",
  "version": "2.0.0",
  "private": true,
  "description": "Live public transport map for Bielsko-Biała and Metropolia GZM: GTFS + GTFS-Realtime scraper, server & map",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/compress-static.mjs out",
    "start": "cargo run --release --manifest-path backend/Cargo.toml",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "build:gtfs": "cargo run --release --manifest-path backend/Cargo.toml -- build-gtfs",
    "build:phototrans": "tsx scripts/build-phototrans.ts",
    "benchmark:site": "tsx scripts/benchmark-site.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "eslint": "^9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
