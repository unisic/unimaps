{
  "name": "unimaps",
  "version": "2.0.0",
  "private": true,
  "description": "Live public transport map for Bielsko-Biała and Metropolia GZM: GTFS + GTFS-Realtime scraper, server & map",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "protobufjs-cli": {
      "glob": "^13.0.0"
    },
    "markdown-it": "^14.3.3"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-8080}",
    "build": "next build",
    "start": "node scripts/start-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:fleet": "tsx scripts/test-live-fleet.ts",
    "build:gtfs": "tsx scripts/build-gtfs.ts",
    "benchmark": "tsx scripts/benchmark-search.ts",
    "benchmark:site": "tsx scripts/benchmark-site.ts"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@phosphor-icons/react": "^2.1.10",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "gtfs-realtime-bindings": "^2.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.15.0",
    "next": "^16.4.3",
    "p-limit": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
